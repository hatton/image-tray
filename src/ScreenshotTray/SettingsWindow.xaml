<Window x:Class="ScreenshotTray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screenshot Tray settings"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBackgroundBrush}">

    <StackPanel Margin="20">

        <TextBlock Text="Watched folder" Style="{StaticResource SettingsLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource TileBackgroundBrush}"
                    BorderBrush="{DynamicResource TileBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,6"
                    VerticalAlignment="Center">
                <TextBlock x:Name="FolderText"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </Border>
            <Button Grid.Column="1"
                    Content="Browse"
                    Style="{StaticResource QuietButton}"
                    Margin="8,0,0,0"
                    Click="OnBrowseClick" />
        </Grid>
        <TextBlock Style="{StaticResource SettingsHint}"
                   Text="Point this at whichever folder your screenshot tool saves into." />

        <Separator Margin="0,18" Background="{DynamicResource WindowBorderBrush}" />

        <TextBlock Text="Screenshots to keep" Style="{StaticResource SettingsLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="KeepSlider"
                    Minimum="4" Maximum="50"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    ValueChanged="OnKeepCountChanged" />
            <TextBlock Grid.Column="1"
                       x:Name="KeepText"
                       MinWidth="28"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
        </Grid>
        <TextBlock Style="{StaticResource SettingsHint}"
                   Text="Anything older than this goes to the Recycle Bin." />

        <Separator Margin="0,18" Background="{DynamicResource WindowBorderBrush}" />

        <TextBlock Text="Thumbnail width" Style="{StaticResource SettingsLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="CellAspectSlider"
                    Minimum="0.5"
                    Maximum="3"
                    TickFrequency="0.05"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    ValueChanged="OnCellAspectChanged" />
            <TextBlock Grid.Column="1"
                       x:Name="CellAspectText"
                       MinWidth="46"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
        </Grid>
        <TextBlock Style="{StaticResource SettingsHint}"
                   Text="Or just drag the splitter that appears when you point between two thumbnails." />

        <Separator Margin="0,18" Background="{DynamicResource WindowBorderBrush}" />

        <TextBlock Text="Appearance" Style="{StaticResource SettingsLabel}" />
        <ComboBox x:Name="ThemeCombo"
                  Width="160"
                  HorizontalAlignment="Left"
                  SelectionChanged="OnThemeChanged">
            <ComboBoxItem Content="Match Windows" Tag="System" />
            <ComboBoxItem Content="Light" Tag="Light" />
            <ComboBoxItem Content="Dark" Tag="Dark" />
        </ComboBox>

        <Separator Margin="0,18" Background="{DynamicResource WindowBorderBrush}" />

        <CheckBox x:Name="PopUpCheck"
                  Content="Bring the strip to the front when I take a screenshot"
                  Foreground="{DynamicResource TextBrush}"
                  FontSize="12"
                  Checked="OnShowOnNewScreenshotChanged"
                  Unchecked="OnShowOnNewScreenshotChanged" />

        <Separator Margin="0,18" Background="{DynamicResource WindowBorderBrush}" />

        <CheckBox x:Name="AutoStartCheck"
                  Content="Start Screenshot Tray when I sign in to Windows"
                  Foreground="{DynamicResource TextBrush}"
                  FontSize="12"
                  Checked="OnAutoStartChanged"
                  Unchecked="OnAutoStartChanged" />

        <Button Content="Done"
                Style="{StaticResource AccentButton}"
                HorizontalAlignment="Right"
                Margin="0,22,0,0"
                MinWidth="88"
                IsDefault="True"
                Click="OnDoneClick" />

    </StackPanel>
</Window>
