<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1D1E21" />
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#26282C" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#3A3D43" />

    <SolidColorBrush x:Key="TextBrush" Color="#ECEDF0" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#9AA0AA" />

    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#2A2C31" />
    <SolidColorBrush x:Key="TileBorderBrush" Color="#3F434A" />
    <SolidColorBrush x:Key="TileHoverBorderBrush" Color="#5C9DFF" />
    <SolidColorBrush x:Key="TileShadowBrush" Color="#000000" />

    <SolidColorBrush x:Key="AccentBrush" Color="#5C9DFF" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#3A3D43" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#474B52" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C93B3B" />

    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#F2F3F5" />
    <SolidColorBrush x:Key="PillTextBrush" Color="#15161A" />

    <!-- Darker squares than the light theme, so a transparent screenshot reads as
         transparent without the checkerboard shouting over the image. -->
    <DrawingBrush x:Key="TransparencyCheckerBrush" TileMode="Tile"
                  Viewport="0,0,16,16" ViewportUnits="Absolute"
                  Viewbox="0,0,16,16" ViewboxUnits="Absolute"
                  Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#4A4E56">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,16,16" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#2A2C31">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,8,8" />
                            <RectangleGeometry Rect="8,8,8,8" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
