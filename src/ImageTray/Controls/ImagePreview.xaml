<UserControl x:Class="ImageTray.Controls.ImagePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <!-- A Popup rather than a Window: it is already a separate top-level surface, so
         it can hang off the top or bottom edge of a 200px strip, and it takes no
         activation, so opening one does not pull focus away from whatever you were
         typing in. Placement is worked out in code, which is also where the choice
         between above and below is made. -->
    <Popup x:Name="Host"
           Placement="Custom"
           AllowsTransparency="True"
           PopupAnimation="Fade"
           StaysOpen="True"
           Focusable="False">

        <!-- Margin leaves room for the shadow, which a Popup will otherwise clip. -->
        <Border x:Name="Frame"
                Margin="14"
                MouseEnter="OnFrameEnter"
                MouseLeave="OnFrameLeave"
                CornerRadius="{StaticResource TileCornerRadius}"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270"
                                  Opacity="0.42" Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- A band on each edge of the image. The one facing the strip
                         carries the buttons; the other is left at no height. -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Canvases, so that the buttons can be positioned under the thumbnail
                     they belong to without that offset becoming part of what the popup
                     measures: as a margin, an offset far to the right would make the
                     popup that much wider, which would move the thumbnail's position
                     within it, and so on. The width the buttons genuinely need is asked
                     for as the frame's MinWidth instead. -->
                <Canvas x:Name="TopBand" Height="0" />

                <Grid Grid.Row="1" MinHeight="120">
                    <!-- The checkerboard means "transparent here", so it goes behind the
                         image and is sized to it, never used as filler around it. -->
                    <Border x:Name="ImageFrame"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="{StaticResource TileCornerRadius}"
                            Background="{DynamicResource TransparencyCheckerBrush}"
                            ClipToBounds="True">
                        <Image x:Name="Full"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <!-- The two things still sitting on the image have to stay legible
                         over a white spreadsheet and a black terminal alike, which is
                         what their fixed dark-on-white treatment is for. -->
                    <Border x:Name="ScaleNote"
                            Visibility="Collapsed"
                            Height="22"
                            CornerRadius="11"
                            Padding="10,0"
                            Background="#E6141518"
                            BorderBrush="White"
                            BorderThickness="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10,10,0,0"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="ScaleText"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Button x:Name="CloseCross"
                            Style="{StaticResource CornerButton}"
                            Focusable="False"
                            Click="OnCloseClick"
                            ToolTip="Close"
                            Margin="0,10,10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" />
                    </Button>
                </Grid>

                <Grid Grid.Row="2" Height="42">
                    <Canvas x:Name="BottomBand">

                        <!-- Everything you can do with the image. These were corner
                             buttons on the thumbnail, where they were small, unlabelled,
                             and sat on top of the thing you were trying to look at.
                             DataContext is set to the view model in code when the
                             preview opens.

                             The code that places the popup moves this between the two
                             bands and sets its position along whichever one it lands in,
                             so that it comes out directly above or below the thumbnail:
                             a short move from where the pointer already is, and never on
                             top of the image. -->
                        <StackPanel x:Name="Actions" Orientation="Horizontal" Canvas.Top="8">

                            <Button Style="{StaticResource OverlayButton}"
                                    Focusable="False"
                                    Command="{Binding CopyImageCommand}"
                                    ToolTip="Copy the image to the clipboard">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="12"
                                               FontWeight="Normal"
                                               Margin="0,0,7,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Copy image" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource OverlayButton}"
                                    Focusable="False"
                                    Content="Copy path"
                                    Command="{Binding CopyPathCommand}"
                                    ToolTip="Copy the full file path"
                                    Margin="8,0,0,0" />

                            <!-- Straight to the Recycle Bin. No confirmation: the
                                 Recycle Bin already is the undo, and a dialog here would
                                 cost the click the app exists to save. -->
                            <Button Style="{StaticResource OverlayDangerButton}"
                                    Focusable="False"
                                    Command="{Binding DeleteCommand}"
                                    ToolTip="Send this image to the Recycle Bin"
                                    Margin="8,0,0,0">
                                <TextBlock Text="&#xE74D;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="12"
                                           FontWeight="Normal" />
                            </Button>
                        </StackPanel>
                    </Canvas>

                    <!-- Close stays on the bottom edge wherever the actions go: moving
                         it around would mean looking for it every time. -->
                    <Button x:Name="CloseText"
                            Style="{StaticResource OverlayButton}"
                            Focusable="False"
                            Content="Close"
                            Click="OnCloseClick"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0" />
                </Grid>
            </Grid>
        </Border>
    </Popup>
</UserControl>
