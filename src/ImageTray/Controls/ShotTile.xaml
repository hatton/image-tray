<UserControl x:Class="ImageTray.Controls.ShotTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             ClipToBounds="False"
             RenderTransformOrigin="0.5,0.5">

    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="TileScale" />
            <TranslateTransform x:Name="TileSlide" />
        </TransformGroup>
    </UserControl.RenderTransform>

    <UserControl.Resources>

        <!-- Press: a small, quick squash so the click feels like it landed on
             something, then a release with a touch of overshoot. -->
        <Storyboard x:Key="PressDown">
            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX"
                             To="0.955" Duration="0:0:0.08">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY"
                             To="0.955" Duration="0:0:0.08">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="PressUp">
            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX"
                             To="1" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.35" EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY"
                             To="1" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.35" EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- A white wash that fades out, so a copy registers even if you were
             looking at a different part of the screen. -->
        <Storyboard x:Key="Flash">
            <DoubleAnimation Storyboard.TargetName="FlashOverlay" Storyboard.TargetProperty="Opacity"
                             From="0.38" To="0" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- The pill marks which screenshot is on the clipboard, so it appears and
             then stays. It comes off when another tile is copied or when the app
             loses focus, both driven from the view model. -->
        <Storyboard x:Key="PillIn">
            <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleX"
                             From="0.88" To="1" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.45" EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY"
                             From="0.88" To="1" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.45" EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="PillOut">
            <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.18" />
        </Storyboard>

        <!-- Arrival: slides in from the left with an accent outline that fades,
             which is enough to notice without pulling focus. -->
        <Storyboard x:Key="Arrival">
            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.22" />
            <DoubleAnimation Storyboard.TargetName="TileSlide" Storyboard.TargetProperty="X"
                             From="-28" To="0" Duration="0:0:0.34">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX"
                             From="0.92" To="1" Duration="0:0:0.34">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1" Duration="0:0:0.34">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="NewOutline" Storyboard.TargetProperty="Opacity"
                             From="1" To="0" BeginTime="0:0:0.2" Duration="0:0:1.5" />
        </Storyboard>

        <Storyboard x:Key="HoverIn">
            <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.12" />
        </Storyboard>

        <Storyboard x:Key="HoverOut">
            <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.18" />
        </Storyboard>

        <Storyboard x:Key="GripIn">
            <DoubleAnimation Storyboard.TargetName="GripHandle" Storyboard.TargetProperty="Opacity"
                             To="0.75" Duration="0:0:0.1" />
        </Storyboard>

        <Storyboard x:Key="GripOut">
            <DoubleAnimation Storyboard.TargetName="GripHandle" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.15" />
        </Storyboard>

    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <!-- The gap to the right of this thumbnail belongs to it, so that
                 hovering the gap is unambiguous and can show a drag grip. -->
            <ColumnDefinition x:Name="GripColumn" Width="12" />
        </Grid.ColumnDefinitions>

        <!-- Hover state is driven from the card area rather than the whole control, so
             pointing at the gap does not also light up the previous thumbnail. -->
        <Grid x:Name="CardArea"
              MouseEnter="OnCardAreaEnter"
              MouseLeave="OnCardAreaLeave">

            <Grid.Triggers>
                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                    <BeginStoryboard Storyboard="{StaticResource HoverIn}" />
                </EventTrigger>
                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                    <BeginStoryboard Storyboard="{StaticResource HoverOut}" />
                </EventTrigger>
            </Grid.Triggers>

        <!-- The whole thumbnail is one button, and clicking anywhere on it opens
             the image at full size. Nothing else is on the tile: copying and
             recycling are on the preview, where there is room to label them and no
             chance of hitting one while reaching for the thumbnail. -->
        <Button x:Name="CardButton"
                Style="{StaticResource BareButton}"
                Click="OnCardClicked"
                ToolTip="{Binding Tooltip}"
                PreviewMouseLeftButtonDown="OnCardPressed"
                PreviewMouseLeftButtonUp="OnCardReleased"
                MouseLeave="OnCardReleased">
            <Grid>
                <!-- The card's own background is flat. Letterbox padding must NOT be
                     the checkerboard: that pattern means "transparent here", so using
                     it as filler both lies and looks noisy. -->
                <Border x:Name="Card"
                        CornerRadius="{StaticResource TileCornerRadius}"
                        Background="{DynamicResource TileBackgroundBrush}"
                        BorderBrush="{DynamicResource TileBorderBrush}"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="7" ShadowDepth="1" Direction="270"
                                          Opacity="0.2" Color="Black" />
                    </Border.Effect>

                    <!-- Sized in code to exactly the image's rendered box, so the
                         checkerboard covers the screenshot and nothing else. -->
                    <Border x:Name="ImageFrame"
                            Background="{DynamicResource TransparencyCheckerBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ClipToBounds="True">
                        <Image x:Name="Thumb"
                               Source="{Binding Thumbnail}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </Border>

                <Border x:Name="HoverRing"
                        CornerRadius="{StaticResource TileCornerRadius}"
                        BorderBrush="{DynamicResource TileHoverBorderBrush}"
                        BorderThickness="1.5"
                        Opacity="0"
                        IsHitTestVisible="False" />

                <Border x:Name="NewOutline"
                        CornerRadius="{StaticResource TileCornerRadius}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="2"
                        Opacity="0"
                        IsHitTestVisible="False" />

                <Border x:Name="FlashOverlay"
                        CornerRadius="{StaticResource TileCornerRadius}"
                        Background="White"
                        Opacity="0"
                        IsHitTestVisible="False" />
            </Grid>
        </Button>

        <!-- Fixed dark-on-white-border colours rather than theme brushes: this sits
             on top of arbitrary screenshot content, so it has to stay legible over
             a white spreadsheet and a black terminal alike.
             Height and CornerRadius are paired at 22 and 11 to give a true
             stadium shape, which an oversized radius alone does not guarantee. -->
        <Border x:Name="Pill"
                Height="22"
                CornerRadius="11"
                Padding="10,0"
                Background="#E6141518"
                BorderBrush="White"
                BorderThickness="1"
                Opacity="0"
                IsHitTestVisible="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="7,7,0,0"
                RenderTransformOrigin="0,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PillScale" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270"
                                  Opacity="0.45" Color="Black" />
            </Border.Effect>
            <TextBlock x:Name="PillText"
                       Text="Copied"
                       Foreground="White"
                       FontSize="11"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Border>

        </Grid>

        <!-- The splitter. Transparent so it is invisible until pointed at, but
             Background must be set rather than left null or it would not be
             hit-testable at all. Dragging it resizes every thumbnail, not this one. -->
        <Border x:Name="Grip"
                Grid.Column="1"
                Background="Transparent"
                Cursor="SizeWE"
                ToolTip="Drag to change the width of every thumbnail"
                MouseEnter="OnGripMouseEnter"
                MouseLeave="OnGripMouseLeave"
                PreviewMouseLeftButtonDown="OnGripPressed"
                PreviewMouseMove="OnGripMoved"
                PreviewMouseLeftButtonUp="OnGripReleased">
            <Border x:Name="GripHandle"
                    Width="4"
                    Height="34"
                    CornerRadius="2"
                    Background="{DynamicResource SubtleTextBrush}"
                    Opacity="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
        </Border>

    </Grid>
</UserControl>
