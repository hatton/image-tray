<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#EBECEF" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#D0D2D8" />

    <SolidColorBrush x:Key="TextBrush" Color="#1B1C1F" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#6C707A" />

    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TileBorderBrush" Color="#D6D8DE" />
    <SolidColorBrush x:Key="TileHoverBorderBrush" Color="#2060D8" />
    <SolidColorBrush x:Key="TileShadowBrush" Color="#000000" />

    <SolidColorBrush x:Key="AccentBrush" Color="#2060D8" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#DADCE2" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#C9CCD4" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#D93A3A" />

    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#1B1C1F" />
    <SolidColorBrush x:Key="PillTextBrush" Color="#FFFFFF" />

    <!-- The checkerboard shows through transparent screenshots, so a shot with a
         cut-out background reads as transparent instead of as white. -->
    <DrawingBrush x:Key="TransparencyCheckerBrush" TileMode="Tile"
                  Viewport="0,0,16,16" ViewportUnits="Absolute"
                  Viewbox="0,0,16,16" ViewboxUnits="Absolute"
                  Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,16,16" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#CFD2D9">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,8,8" />
                            <RectangleGeometry Rect="8,8,8,8" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
